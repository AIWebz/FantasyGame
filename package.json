{
  "name": "realm-of-embers",
  "productName": "Realm of Embers",
  "version": "1.0.0",
  "description": "A fantasy RPG with classes, quests, side quests and leveling.",
  "main": "main.js",
  "author": "Realm of Embers",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "com.realmofembers.game",
    "productName": "Realm of Embers",
    "files": [
      "main.js",
      "src/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Realm of Embers"
    }
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "three": "^0.160.0"
  }
}
